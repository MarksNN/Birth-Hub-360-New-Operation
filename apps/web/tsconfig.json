{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@birthub/contracts": ["../../packages/contracts/src/index.ts"],
      "@birthub/design-system": ["../../packages/design-system/src/index.ts"],
      "@birthub/design-system/*": ["../../packages/design-system/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}