# ============================================================
# Birthub 360 Full Operation — Configuração de Ambiente
# Nunca versionar arquivos .env com credenciais reais de produção.
# ============================================================

# Runtime
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Banco de Dados Local (PostgreSQL)
POSTGRES_DB=birthub_local
POSTGRES_USER=birthub_admin
POSTGRES_PASSWORD=birthub_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://birthub_app:birthub_app_dev_secret@localhost:5432/birthub_local

# Mensageria & Filas (Redis)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Provedor de IA (Gemini / Anthropic / Mock)
AI_PROVIDER=gemini
AI_MODEL_RADAR=gemini-2.5-flash
AI_MODEL_COPILOT=gemini-2.5-flash
GEMINI_API_KEY=

# Integrações (Bitrix24)
BITRIX24_WEBHOOK_URL=
